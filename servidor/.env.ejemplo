# ═══════════════════════════════════════════════════════════════════
# Galene · servidor — configuración por entorno.
#
# Cópialo a `.env` y ajústalo. NADA de esto tiene un valor por defecto
# secreto: si `GALENE_SECRETO` no se pone, el servidor arranca con uno
# aleatorio de cada arranque, y eso invalida todas las sesiones y todas
# las llaves de borrado al reiniciar. En producción hay que ponerlo.
# ═══════════════════════════════════════════════════════════════════

# ── Red ────────────────────────────────────────────────────────────
GALENE_PUERTO=5178
GALENE_HOST=0.0.0.0

# Orígenes que pueden llamar a la API, separados por comas. El sitio en
# local va en 5177; en producción es el dominio donde viva el estático.
# Un `*` aquí NO se admite: con credenciales fuera, un comodín sigue
# permitiendo que cualquier página del mundo escriba en la comunidad.
GALENE_ORIGENES=http://localhost:5177,http://127.0.0.1:5177

# 1 si detrás hay un proxy (Fly, Railway, nginx) y hay que leer
# X-Forwarded-For para limitar por IP. Con 0, se usa la IP del socket.
GALENE_CONFIAR_PROXY=0

# ── Secretos ───────────────────────────────────────────────────────
# 32+ bytes en hexadecimal. `openssl rand -hex 32`
GALENE_SECRETO=
# Llave de moderación: cabecera `X-Galene-Llave`. Sin ella, la cola de
# moderación no existe (los endpoints responden 404).
GALENE_LLAVE_MODERACION=

# ── La bandada ─────────────────────────────────────────────────────
GALENE_GARZAS_MAX=10
# TIENE que coincidir con PERCHAS.length en src/js/main.js (hoy: 11).
GALENE_PERCHAS=11
# 1 = cualquiera puede pintarle el pico a cualquier garza (mural común).
# 0 = solo quien la dejó.
GALENE_PICO_AJENO=1

# ── El mar ─────────────────────────────────────────────────────────
# Segundos de gesto que se le acreditan a una sesión, como máximo.
GALENE_TOPE_SESION=240
# τ de la curva de raíces. Más alto = la comunidad tarda más en notarse.
GALENE_TAU_RAICES=500
# Cuánto del rango de calma puede llegar a poner la comunidad (0..1).
# Menos de 1 A PROPÓSITO: ver LEEME.md, «la calma que se satura».
GALENE_TECHO_RAICES=0.55

# ── La comunidad ───────────────────────────────────────────────────
# posterior = se publica al momento; previa = todo pasa por la cola.
GALENE_MODERACION=posterior
# Reportes distintos que ocultan algo automáticamente.
GALENE_REPORTES_OCULTAR=3
# Días que se guarda lo borrado antes de purgarlo de verdad.
GALENE_DIAS_RETENCION=30

# ── Base ───────────────────────────────────────────────────────────
GALENE_BASE=./datos/galene.db
