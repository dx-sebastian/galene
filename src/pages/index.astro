---
/* ═══════════════════════════════════════════════════════════════════
   Galene — la portada.

   El sitio pasó a Astro: cero JavaScript por defecto en las páginas de
   contenido, y el mar entra como ISLA. Aquí no hay framework de UI —
   el mundo es un canvas y un canvas no se beneficia de uno—, pero sí
   hay build: rutas con base, bundling, hashing y un sitio que puede
   crecer a blog y rutas sin escribir cuarenta HTML a mano.

   La barra de urgencia salió del sitio: esa parte se traslada a una app
   móvil y volverá aquí de otra forma.
   ═══════════════════════════════════════════════════════════════════ */
import '../estilos/estilos.css';
import Mundo from '../componentes/Mundo.astro';
import Herramientas from '../componentes/Herramientas.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="es" data-tinta="oscura">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

  <title>Galene — Sumisión química: qué hacer, y hasta cuándo</title>
  <meta name="description" content="Qué se puede hacer después de una sumisión química, y hasta cuándo. Ventanas de tiempo y rutas de atención en Colombia." />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Galene — Sumisión química: qué hacer, y hasta cuándo" />
  <meta property="og:description" content="Qué se puede hacer después de una sumisión química, y hasta cuándo." />
  <meta name="theme-color" content="#2E4256" />
  <meta property="og:image" content={base + 'arte/1024/manglar-enterrado-a.webp'} />

  {/* BORRADOR: mientras las ventanas médicas no estén verificadas contra
      fuente primaria, esto no debe ser encontrable. */}
  <meta name="robots" content="noindex, nofollow" />

  <link rel="preload" as="font" type="font/woff2" crossorigin
        href={base + 'fuentes/Atkinson-Hyperlegible-Regular.woff2'} />
</head>

<body>
  <Mundo />

  <main>
    <section class="hero" id="mar">
      {/* SEO: el H1 lleva la FRASE DE BÚSQUEDA, no la marca. Nadie
          busca "Galene"; buscan "sumisión química qué hacer". La marca
          queda arriba como lema, igual de grande — la jerarquía visual
          y la semántica no tienen por qué coincidir. */}
      <div class="hero__texto">
        <p class="titulo">Galene</p>
        <h1 class="lockup">Sumisión química: qué hacer, y hasta cuándo.</h1>
      </div>

      {/* EL MANGLAR DE RAÍCES DESNUDAS — acuarela propia, plano cercano
          del paralaje. Viene sobre papel blanco: multiply la funde con
          el mar como una aguada de verdad. Decorativa: alt vacío. */}
      <img class="hero__arco" id="arco" alt="" aria-hidden="true"
           decoding="async" fetchpriority="low"
           src={base + 'arte/1024/manglar-enterrado-a.webp'}
           srcset={base + 'arte/1024/manglar-enterrado-a.webp 1024w, '
                 + base + 'arte/manglar-enterrado-a.webp 2048w'}
           sizes="(max-width: 1100px) 60vw, 40vw" />

      <a class="cta" href="#herramientas">Qué puedo hacer ahora</a>

      <p class="hero__nota" id="nota-hora"></p>
    </section>

    <Herramientas />
  </main>

  <script>
    import '../js/main.js';
    import '../js/paralaje.js';
    import '../js/herramientas.js';
  </script>
</body>
</html>
