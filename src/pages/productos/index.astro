---
/* ═══════════════════════════════════════════════════════════════════
   Galene — el catálogo de prevención, en su propia página.

   Estuvo en la portada y salió por orden del dueño: la portada cuenta
   qué hacer DESPUÉS, y un catálogo en medio de esa lectura era otra
   voz. Aquí tiene la suya, con la misma hoja de papel, la misma barra
   y el mismo pie que /comunidad y /expertos.

   ESTA PÁGINA ES EL MOSTRADOR. Cada pieza tiene además su ficha en
   /productos/<id>, donde vive la descripción larga; aquí solo se ve
   lo que se ve de lejos: foto, nombre, una frase y el botón.

   LAS FOTOGRAFÍAS SON DEL FABRICANTE (NightCap). Se usan por el
   acuerdo de distribución en curso — Galene importará y venderá estas
   mismas piezas — y se acredita al pie de la sección. Si el acuerdo
   cambiara, las láminas ilustradas de la primera versión siguen en
   arte/productos/ listas para volver.
   ═══════════════════════════════════════════════════════════════════ */
import '../../estilos/estilos.css';
import '../../estilos/nuevas-secciones.css';
import '../../estilos/responsive.css';
import Barra from '../../componentes/Barra.astro';
import Productos from '../../componentes/Productos.astro';
import Pie from '../../componentes/Pie.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const TITULO = 'Productos de prevención — Galene';
const RESUMEN = 'Fundas, sellos y tapas que cierran una copa, una lata ' +
  'o una botella. Piezas sencillas de prevención, con sus límites ' +
  'dichos de frente.';
---

<!doctype html>
<html lang="es" data-tinta="oscura">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

  <title>{TITULO}</title>
  <meta name="description" content={RESUMEN} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={TITULO} />
  <meta property="og:description" content={RESUMEN} />
  <meta name="theme-color" content="#2E4256" />
  <link rel="icon" type="image/svg+xml" href={base + 'favicon.svg'} />

  <meta name="robots" content="noindex, nofollow" />

  <link rel="preload" as="font" type="font/woff2" crossorigin
        href={base + 'fuentes/Atkinson-Hyperlegible-Regular.woff2'} />
</head>

<body class="pagina-papel">

  <Barra actual="productos" />

  <main class="productos-pagina">
    <Productos />

    <p class="expertos-pagina__volver">
      <a href={base}>← Volver a la portada</a>
    </p>
    <Pie />
  </main>

  <script>import '../../js/viewport.js';</script>
  <script>import '../../js/luz.js';</script>
  <script>import '../../js/menu.js';</script>
</body>
</html>
