---
/* ═══════════════════════════════════════════════════════════════════
   EL MOSTRADOR — el catálogo de prevención, en lista.

   Segunda forma de esta sección, a pedido del dueño: «en mobile
   deberían verse como productos de amazon, y la descripción dentro de
   la página del producto». Así que aquí NO hay descripción larga ni
   especificaciones plegadas: foto, nombre, una frase y el botón. Todo
   lo demás vive en /productos/<id>, la ficha de cada pieza.

   La tarjeta entera es un enlace a su ficha —foto y texto dentro del
   mismo <a>, que es como se toca en un teléfono— y el botón de compra
   queda FUERA de ese enlace: dos cosas que se pulsan no pueden estar
   una dentro de la otra.

   LAS TRES REGLAS siguen escritas en datos/productos.js, con los
   datos: nada promete seguridad total, nada traslada la carga, y no
   hay precio mientras la importación se esté cerrando.
   ═══════════════════════════════════════════════════════════════════ */
import { PRODUCTOS, CREDITO_FOTOS } from '../datos/productos.js';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section class="productos" id="productos" aria-labelledby="productos-titulo">
  <div class="trazo" aria-hidden="true"></div>

  {/* Sin párrafo de intro, por orden del dueño: en un catálogo la
      cabecera presenta y las fichas hablan. */}
  <header class="productos__cabecera">
    <p class="seccion-rotulo">Prevención · Catálogo</p>
    <h2 id="productos-titulo">Antes de esa noche</h2>
  </header>

  <ul class="productos__lista">
    {PRODUCTOS.map((p) => (
      <li class="producto" id={'producto-' + p.id}>
        {/* FOTOGRAFÍA DEL FABRICANTE, no lámina propia: el catálogo
            vende exactamente estas piezas (acuerdo de distribución en
            curso; crédito al pie de la sección). Las ilustraciones de
            la primera versión siguen en arte/productos/. */}
        <a class="producto__enlace" href={`${base}productos/${p.id}`}>
          <span class="producto__marco">
            <img src={`${base}productos/${p.id}.webp`} alt={p.nombre}
                 width="450" height="450" loading="lazy" decoding="async" />
          </span>

          {/* SIN SELLO Y SIN PÁRRAFO, por orden del dueño: «quítale los
              badgets y tanto texto». En el mostrador quedan la foto, el
              nombre y una línea; todo lo demás —el tipo de uso, la
              descripción, las especificaciones— está a un toque, en la
              ficha de la pieza. */}
          <span class="producto__cuerpo">
            <span class="producto__nombre">{p.nombre}</span>
            <span class="producto__lema">{p.lema}</span>
          </span>
        </a>

        <button class="producto__comprar acuarela" type="button"
                data-nombre={p.nombre}>
          <span class="acuarela__texto">Comprar</span>
        </button>
      </li>
    ))}
  </ul>

  <p class="productos__nota">
    Catálogo de importación en preparación: el botón registra tu interés.
    {' ' + CREDITO_FOTOS}
  </p>
</section>

<script>import '../js/pedido.js';</script>
