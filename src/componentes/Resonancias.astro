<section class="resonancias" aria-labelledby="resonancias-titulo">
  <h3 id="resonancias-titulo" class="visualmente-oculto">Lo que queda</h3>

  <figure class="resonancia resonancia--libertad">
    <svg viewBox="0 0 320 240" role="img" aria-labelledby="res-libertad">
      <title id="res-libertad">Dos manos sostienen un circulo abierto</title>
      <defs>
        <filter id="agua-libertad" x="-20%" y="-20%" width="140%" height="140%">
          <feTurbulence type="fractalNoise" baseFrequency=".018 .045" numOctaves="3" seed="4" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="8" />
          <feGaussianBlur stdDeviation=".45" />
        </filter>
        <linearGradient id="tinta-libertad" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#6f91aa" />
          <stop offset=".55" stop-color="#927da4" />
          <stop offset="1" stop-color="#d38f82" />
        </linearGradient>
      </defs>
      <g filter="url(#agua-libertad)" fill="none" stroke-linecap="round">
        <circle cx="160" cy="106" r="70" stroke="url(#tinta-libertad)" stroke-width="16" opacity=".35" />
        <circle cx="160" cy="106" r="75" stroke="url(#tinta-libertad)" stroke-width="8" opacity=".62" stroke-dasharray="370 100" />
        <path d="M52 185 C78 155 96 142 126 134 C112 162 101 183 93 210" stroke="#6f87a6" stroke-width="18" opacity=".38" />
        <path d="M268 185 C242 155 224 142 194 134 C208 162 219 183 227 210" stroke="#b77f96" stroke-width="18" opacity=".38" />
        <path d="M68 198 C92 166 112 151 139 143 M252 198 C228 166 208 151 181 143" stroke="#23374c" stroke-width="2.2" opacity=".78" />
      </g>
    </svg>
    <figcaption>No falto fuerza.<br /><strong>Falto libertad.</strong></figcaption>
  </figure>

  <figure class="resonancia resonancia--vacio">
    <svg viewBox="0 0 320 240" role="img" aria-labelledby="res-vacio">
      <title id="res-vacio">Un perfil entre manchas de agua y un espacio en blanco</title>
      <defs>
        <filter id="agua-vacio" x="-20%" y="-20%" width="140%" height="140%">
          <feTurbulence type="fractalNoise" baseFrequency=".025" numOctaves="4" seed="11" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="10" />
          <feGaussianBlur stdDeviation=".65" />
        </filter>
        <radialGradient id="lavado-vacio">
          <stop offset="0" stop-color="#789fa3" stop-opacity=".72" />
          <stop offset="1" stop-color="#789fa3" stop-opacity="0" />
        </radialGradient>
      </defs>
      <g filter="url(#agua-vacio)">
        <ellipse cx="116" cy="112" rx="88" ry="92" fill="url(#lavado-vacio)" />
        <ellipse cx="206" cy="92" rx="72" ry="68" fill="#b99bc2" opacity=".22" />
        <ellipse cx="173" cy="142" rx="94" ry="56" fill="#dc9e91" opacity=".18" />
        <path d="M145 49 C127 70 124 97 137 115 C145 126 151 137 147 156 C160 153 171 146 179 135 C187 123 188 110 181 101 C174 92 171 81 176 68" fill="none" stroke="#213449" stroke-width="3" />
        <path d="M176 68 C188 77 194 87 192 98 C190 107 197 114 211 119" fill="none" stroke="#213449" stroke-width="2" />
      </g>
    </svg>
    <figcaption>El vacio<br /><strong>no te contradice.</strong></figcaption>
  </figure>

  <figure class="resonancia resonancia--noche">
    <svg viewBox="0 0 320 240" role="img" aria-labelledby="res-noche">
      <title id="res-noche">Una figura quieta frente a un horizonte de agua</title>
      <defs>
        <filter id="agua-noche" x="-20%" y="-20%" width="140%" height="140%">
          <feTurbulence type="fractalNoise" baseFrequency=".016 .04" numOctaves="3" seed="18" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="9" />
        </filter>
        <linearGradient id="cielo-noche" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#eab8a7" stop-opacity=".62" />
          <stop offset=".55" stop-color="#b9a5bf" stop-opacity=".4" />
          <stop offset="1" stop-color="#7599a1" stop-opacity=".12" />
        </linearGradient>
      </defs>
      <g filter="url(#agua-noche)">
        <circle cx="165" cy="103" r="79" fill="url(#cielo-noche)" opacity=".78" />
        <path d="M42 151 C90 139 125 156 166 148 C208 140 244 151 281 143 L281 190 L42 190 Z" fill="#6f969e" opacity=".25" />
        <path d="M39 158 C86 149 122 163 165 155 C212 146 244 159 282 151" fill="none" stroke="#31556b" stroke-width="2" opacity=".7" />
        <path d="M157 96 C150 104 149 115 155 123 L151 170 L178 170 L174 123 C181 112 178 101 168 96 Z" fill="#263849" opacity=".85" />
        <path d="M126 75 q8 -8 16 0 q8 -8 16 0 M219 66 q7 -7 14 0 q7 -7 14 0" fill="none" stroke="#263849" stroke-width="2" />
      </g>
    </svg>
    <figcaption>No tienes que<br /><strong>resolver esa noche.</strong></figcaption>
  </figure>

  <figure class="resonancia resonancia--cuerpo">
    <svg viewBox="0 0 320 240" role="img" aria-labelledby="res-cuerpo">
      <title id="res-cuerpo">Una linea organica protegida por dos arcos</title>
      <defs>
        <filter id="agua-cuerpo" x="-20%" y="-20%" width="140%" height="140%">
          <feTurbulence type="fractalNoise" baseFrequency=".02" numOctaves="3" seed="25" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="7" />
          <feGaussianBlur stdDeviation=".4" />
        </filter>
        <linearGradient id="tinta-cuerpo" x1="0" y1="1" x2="1" y2="0">
          <stop offset="0" stop-color="#6b93a5" />
          <stop offset=".5" stop-color="#a187b0" />
          <stop offset="1" stop-color="#d59a87" />
        </linearGradient>
      </defs>
      <g filter="url(#agua-cuerpo)" fill="none" stroke-linecap="round">
        <path d="M62 175 C45 117 79 58 137 43" stroke="#29405b" stroke-width="13" opacity=".34" />
        <path d="M258 175 C275 117 241 58 183 43" stroke="#29405b" stroke-width="13" opacity=".34" />
        <path d="M132 66 C153 86 141 108 160 125 C179 108 167 86 188 66 M160 125 C149 145 150 170 160 190 C170 170 171 145 160 125" stroke="url(#tinta-cuerpo)" stroke-width="11" opacity=".8" />
        <path d="M132 66 C153 86 141 108 160 125 C179 108 167 86 188 66 M160 125 C149 145 150 170 160 190" stroke="#263849" stroke-width="2" opacity=".75" />
      </g>
    </svg>
    <figcaption>Tu cuerpo<br /><strong>no fue la prueba que fallo.</strong></figcaption>
  </figure>
</section>
