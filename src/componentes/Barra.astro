---
/* ═══════════════════════════════════════════════════════════════════
   LA BARRA DE LAS PÁGINAS DE PAPEL.

   Era el mismo bloque copiado en /comunidad, /expertos y /productos.
   Con la ficha de producto habría sido la cuarta copia, y una copia
   que se olvida es exactamente cómo /comunidad se quedó sin la fila
   de escritorio hasta que el dueño la echó en falta. Una sola pieza,
   y el `actual` dice qué enlace va marcado.

   La portada NO la usa: allí la barra flota sobre el mar
   (`barra--flotante`) y tiene su propia vida.
   ═══════════════════════════════════════════════════════════════════ */
import { enlaces } from '../datos/navegacion.js';

const { actual } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const ENLACES = enlaces(base);
---

<header class="barra barra--papel">
  <a class="marca" href={base}>
    <span class="marca__nombre">Galene</span>
    <svg class="marca__ola" viewBox="0 0 120 10" preserveAspectRatio="none"
         aria-hidden="true" focusable="false">
      <path d="M1 6 C 10 2.2, 21 2.2, 30 6 S 50 9.8, 60 5.8
               S 80 1.8, 90 5.6 S 111 9.4, 119 6.6"
            fill="none" stroke="currentColor" stroke-width="1.15"
            stroke-linecap="round" vector-effect="non-scaling-stroke" />
    </svg>
  </a>

  <nav class="barra__nav" aria-label="Principal">
    {/* La fila de escritorio y el menú de bolsillo leen la MISMA
        lista de datos/navegacion.js: a partir de 940 px se muestra la
        fila y se esconde el botón de menú. */}
    <div class="barra__enlaces">
      {ENLACES.map(([texto, href]) => (
        <a class="barra__enlace" href={href}
           aria-current={href.endsWith(actual) ? 'page' : undefined}>{texto}</a>
      ))}
    </div>

    <details class="menu" name="barra-menu">
      <summary class="menu__boton" aria-label="Abrir menu de navegacion">
        <span class="menu__rayas" aria-hidden="true"></span>
        <span class="menu__etiqueta">Menu</span>
      </summary>
      <div class="menu__panel">
        {ENLACES.map(([texto, href]) => (
          <a class="barra__enlace" href={href}
             aria-current={href.endsWith(actual) ? 'page' : undefined}>{texto}</a>
        ))}
        <a class="pildora pildora--menu" href={base + '#ayuda'}>
          Buscar ayuda
          <svg class="pildora__icono" viewBox="0 0 14 12"
               aria-hidden="true" focusable="false">
            <path d="M1 6 H12.4 M8.6 2.2 L12.6 6 L8.6 9.8"
                  fill="none" stroke="currentColor" stroke-width="1.3"
                  stroke-linecap="round" stroke-linejoin="round"
                  vector-effect="non-scaling-stroke" />
          </svg>
        </a>
      </div>
    </details>
  </nav>
</header>
